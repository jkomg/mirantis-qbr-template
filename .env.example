# Salesforce credentials — copy to .env and fill in.
# .env is gitignored; never commit real values.
#
# ---------------------------------------------------------------------------
# Client Credentials (recommended for Mirantis sandbox)
# ---------------------------------------------------------------------------
# OAuth 2.0 Client Credentials — server-to-server. No browser "Connect" step.
# Uses the Connected App's assigned integration user.
#
# From your sandbox URL:
#   https://mirantis--mkeops.sandbox.my.salesforce.com/
# set SF_DOMAIN to the My Domain part only:
#   mirantis--mkeops.sandbox.my
#
SF_AUTH_MODE=client_credentials
SF_CONSUMER_KEY=
SF_CONSUMER_SECRET=
SF_DOMAIN=mirantis--mkeops.sandbox.my
# Optional label shown in the Configurator UI:
# SF_INTEGRATION_USER=your-integration-user@example.com

# ---------------------------------------------------------------------------
# Browser OAuth (Authorization Code — each TAM logs in)
# ---------------------------------------------------------------------------
# SF_AUTH_MODE=oauth
# SF_CONSUMER_KEY=
# SF_CONSUMER_SECRET=
# SF_REDIRECT_URI=http://localhost:8081/oauth/callback
# SF_DOMAIN=test
# FLASK_SECRET_KEY=change-me-to-a-long-random-string
# CONFIGURATOR_URL=http://localhost:8080/QBR%20Configurator.dc.html

# ---------------------------------------------------------------------------
# Password flow (optional — CLI / legacy)
# ---------------------------------------------------------------------------
# SF_AUTH_MODE=password
# SF_USERNAME=service-account@example.com
# SF_PASSWORD=
# SF_SECURITY_TOKEN=
# SF_DOMAIN=test

# Optional — version stamp written into payload._meta.source
SYNC_VERSION=v0.6

# ---------------------------------------------------------------------------
# Optional AI account-status review (Configurator "Generate status commentary")
# ---------------------------------------------------------------------------
# Provide one provider key. OpenAI is preferred when both are set.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
